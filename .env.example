# ── PostgreSQL ─────────────────────────────
POSTGRES_USER=svoikrug
POSTGRES_PASSWORD=svoikrug_secret
POSTGRES_DB=svoikrug_dev

# ── Backend (api/.env) ─────────────────────
# DATABASE_URL будет переопределён в docker-compose
# Локально (без Docker) используй:
# DATABASE_URL="postgresql://svoikrug:svoikrug_secret@localhost:5432/svoikrug_dev?schema=public"
PORT=4000
JWT_SECRET=svoikrug_dev_secret_change_me_in_prod

# ── Frontend (web/.env.local) ──────────────
NEXT_PUBLIC_API_URL=http://localhost:4000