# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=svoikrug
POSTGRES_PASSWORD=svoikrug_secret
POSTGRES_DB=svoikrug_dev

# ── Backend (api/.env) ─────────────────────────────────────
# DATABASE_URL будет переопределён в docker-compose
# Локально (без Docker) используй:
# DATABASE_URL="postgresql://svoikrug:svoikrug_secret@localhost:5432/svoikrug_dev?schema=public"
PORT=4000
JWT_SECRET=svoikrug_dev_secret_change_me_in_prod

# ── Frontend (web/.env.local) ──────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Production (docker compose -f docker-compose.prod.yml) ──
# Скопируй этот файл в .env (он в .gitignore) и задай сильные
# значения. API не стартует в production с дефолтными секретами.
#
# POSTGRES_PASSWORD=<сильный случайный пароль; URL-безопасный или percent-encoded>
# POSTGRES_DB=svoikrug
# JWT_SECRET=<минимум 64 случайных символа, openssl rand -hex 48>
# COOKIE_SECRET=<другой минимум 64 символа, openssl rand -hex 48>
# NEXT_PUBLIC_API_URL=https://svoikrug.ru
# API_PORT=4000
# WEB_PORT=3000
