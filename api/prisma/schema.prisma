// api/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ───────────────────────────────────────────────
enum UserStatus {
  active
  suspended
}

enum EventStatus {
  draft
  published
  closed
  archived
}

// Формат встречи: офлайн, спорт или онлайн.
enum EventFormat {
  offline
  sport
  online
}

// География участия онлайн-встречи: «любой город» или «только город хоста».
enum ParticipantGeo {
  any
  city
}

enum SportLevel {
  beginner
  amateur
  pro
}

enum BudgetType {
  free
  split
}

enum GuestStatus {
  pending
  approved
  rejected
  attended
  cancelled
}

// Скрытые категории тегов: в UI теги показываются единым облаком,
// но в БД у каждого тега есть тип — для фильтрации и будущей аналитики.
enum TagCategory {
  atmosphere
  format
  interest
}

// ── MODELS ──────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @map("id")
  email         String    @unique @map("email")
  phone         String?   @unique @map("phone")
  passwordHash  String    @map("password_hash")
  status        UserStatus @default(active) @map("status")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  profile       Profile?
  hostedEvents  Event[]   @relation("EventHost")
  joinedEvents  EventGuest[]
  followers     Subscription[] @relation("Follower")
  following     Subscription[] @relation("Following")
  ratingsGiven  Rating[]  @relation("Rater")
  ratingsReceived Rating[] @relation("Rated")
  refreshTokens RefreshToken[]
  notifications     Notification[]
  chatMemberships   ChatMember[]
  chatMessages      ChatMessage[]

  @@map("users")
  @@index([email])
  @@index([status])
}

model Profile {
  userId      String  @id @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname    String  @unique @map("nickname")
  bio         String? @map("bio")
  avatarUrl   String? @map("avatar_url")
  district    String? @map("district")
  city        String? @map("city")
  birthDate   DateTime? @map("birth_date") @db.Date
  trustScore  Float   @default(0) @map("trust_score")
  isVerified  Boolean @default(false) @map("is_verified")

  @@map("profiles")
  @@index([nickname])
  @@index([district])
}

model Event {
  id          String      @id @default(uuid()) @map("id")
  hostId      String      @map("host_id")
  host        User        @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  title       String      @map("title")
  description String?     @map("description")
  theme       String?     @map("theme")
  format      EventFormat @default(offline) @map("format")
  subcategory String?     @map("subcategory")
  city        String?     @map("city")
  addressPublic  String?  @map("address_public")
  addressPrivate String?  @map("address_private")
  coverImageUrl String?   @map("cover_image_url")
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime?   @map("ends_at")
  durationMinutes    Int?      @map("duration_minutes")
  maxGuests   Int?        @map("max_guests")
  waitlistEnabled    Boolean   @default(false) @map("waitlist_enabled")
  plusOneEnabled     Boolean   @default(false) @map("plus_one_enabled")
  status      EventStatus @default(draft) @map("status")
  rules       Json?       @map("rules")
  houseRules         String?   @map("house_rules")
  houseRulesChips    String[]  @default([]) @map("house_rules_chips")
  applicationQuestion String?  @map("application_question")
  sportLevel         SportLevel? @map("sport_level")
  weatherDependent   Boolean   @default(false) @map("weather_dependent")
  budgetType         BudgetType @default(free) @map("budget_type")
  budgetAmount       Int?      @map("budget_amount")
  budgetNote         String?   @map("budget_note")
  venueType          String?   @map("venue_type")
  platform           String?   @map("platform")
  // Приватная ссылка на онлайн-встречу: доступ как у addressPrivate.
  meetingLink        String?   @map("meeting_link")
  participantGeo     ParticipantGeo @default(any) @map("participant_geo")
  lat         Float?      @map("lat")
  lng         Float?      @map("lng")
  createdAt   DateTime    @default(now()) @map("created_at")

  guests      EventGuest[]
  ratings     Rating[]
  tags        EventTag[]
  chat        Chat?

  @@map("events")
  @@index([hostId])
  @@index([status, startsAt])
  @@index([format, startsAt])
  @@index([subcategory])
  @@index([city])
  @@index([lat, lng])
}

// Справочник вайб-тегов. Заполняется миграцией; slug — стабильный ключ,
// label можно менять без миграции данных.
model Tag {
  slug      String      @id @map("slug")
  label     String      @map("label")
  category  TagCategory @map("category")
  sortOrder Int         @default(0) @map("sort_order")
  // Форматы, в которых доступен вайб. Пустой массив трактуем как «во всех».
  allowedFormats EventFormat[] @default([offline, sport, online]) @map("allowed_formats")
  // Заголовок группы для визуального разделения чипов в визарде.
  groupLabel String? @map("group_label")

  events    EventTag[]

  @@map("tags")
  @@index([category, sortOrder])
  @@index([sortOrder])
}

model EventTag {
  eventId String @map("event_id")
  tagSlug String @map("tag_slug")

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagSlug], references: [slug], onDelete: Cascade)

  @@id([eventId, tagSlug])
  @@map("event_tags")
  @@index([tagSlug])
}

model EventGuest {
  id        String     @id @default(uuid()) @map("id")
  eventId   String     @map("event_id")
  userId    String     @map("user_id")
  status    GuestStatus @default(pending) @map("status")
  applicationAnswer String? @map("application_answer")
  joinedAt  DateTime   @default(now()) @map("joined_at")

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("event_guests")
  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId, status])
}

model Subscription {
  id          String   @id @default(uuid()) @map("id")
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Rating {
  id        String   @id @default(uuid()) @map("id")
  eventId   String   @map("event_id")
  raterId   String   @map("rater_id")
  ratedId   String   @map("rated_id")
  score     Int      @map("score") // 1-5
  comment   String?  @map("comment")
createdAt DateTime @default(now()) @map("created_at")

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rater     User     @relation("Rater", fields: [raterId], references: [id], onDelete: Cascade)
  rated     User     @relation("Rated", fields: [ratedId], references: [id], onDelete: Cascade)

  @@map("ratings")
  @@index([eventId])
  @@index([ratedId, createdAt])
  @@index([raterId, eventId], name: "idx_rating_unique")
}

model RefreshToken {
  id          String   @id @default(uuid())
  tokenHash   String   @unique @map("token_hash")
  userId      String   @map("user_id")
  deviceId    String?  @map("device_id")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  payload   Json
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// Чат события: создаётся автоматически вместе с событием.
// expiresAt — момент, после которого чат удаляется (окончание события или
// отмена + 30 дней). Чистка ленивая: при обращении к чат-эндпоинтам.
model Chat {
  id            String   @id @default(uuid())
  eventId       String?  @unique @map("event_id")
  event         Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  // Снимок события: чат переживает удаление события на 30 дней.
  title         String
  coverImageUrl String?  @map("cover_image_url")
  startsAt      DateTime @map("starts_at")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  members  ChatMember[]
  messages ChatMessage[]

  @@index([expiresAt])
  @@map("chats")
}

model ChatMember {
  chatId     String   @map("chat_id")
  userId     String   @map("user_id")
  lastReadAt DateTime @default(now()) @map("last_read_at")
  joinedAt   DateTime @default(now()) @map("joined_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_members")
}

model ChatMessage {
  id        String   @id @default(uuid())
  chatId    String   @map("chat_id")
  senderId  String   @map("sender_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("chat_messages")
}
