generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  rating    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostedEvents Event[] @relation("HostedEvents")
  participations EventParticipant[]
  reviewsGiven   Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  hostId      String
  host        User     @relation("HostedEvents", fields: [hostId], references: [id])
  
  district    String
  latitude    Float?
  longitude   Float?
  exactAddress String?
  
  startTime   DateTime
  endTime     DateTime
  maxParticipants Int @default(10)
  theme       String[]
  
  status      EventStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants EventParticipant[]
  reviews      Review[]
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

model EventParticipant {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  
  status    ParticipantStatus @default(PENDING)
  joinedAt  DateTime @default(now())

  @@unique([userId, eventId])
}

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  LEFT
}

model Review {
  id          String   @id @default(uuid())
  fromUserId  String
  fromUser    User     @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User     @relation("ReviewsReceived", fields: [toUserId], references: [id])
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id])
  
  rating      Int      @default(5)
  comment     String?
  badges      String[]
  
  createdAt   DateTime @default(now())

  @@index([toUserId])
}
