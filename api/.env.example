# Database
DATABASE_URL=postgresql://svoikrug:svoikrug_secret@db:5432/svoikrug_dev?schema=public

# ── Secrets ──────────────────────────────────────────────────
# В production используй сильные случайные значения (НЕ эти).
# Сгенерировать можно так: openssl rand -hex 48
#
# JWT_SECRET: минимум 64 символа. API откажется стартовать
# в NODE_ENV=production с коротким или дефолтным секретом.
JWT_SECRET=svoikrug_dev_jwt_secret_change_in_production_min_64_chars_not_for_prod
# COOKIE_SECRET: в production должен быть ОТДЕЛЬНЫМ от JWT_SECRET
# (минимум 64 символа). Если не задан, используется JWT_SECRET.
COOKIE_SECRET=svoikrug_dev_cookie_secret_change_in_production_min_64_chars_not_for_prod

# Access/refresh token lifetimes (currently fixed in code; kept for documentation)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Server
PORT=4000
# production — для запуска собранного образа; development — локально.
NODE_ENV=development
